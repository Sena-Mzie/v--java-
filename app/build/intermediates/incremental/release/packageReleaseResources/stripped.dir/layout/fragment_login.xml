<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vuka_navy_dark"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/iv_logo_login"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_vuka_shield"
            android:contentDescription="@string/content_desc_vuka_logo"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_welcome_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_back"
            android:textColor="@color/vuka_text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:gravity="center"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/iv_logo_login"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_enter_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enter_phone"
            android:textColor="@color/vuka_text_secondary"
            android:textSize="14sp"
            android:textAlignment="center"
            android:gravity="center"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tv_welcome_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Phone number input row -->
        <LinearLayout
            android:id="@+id/ll_phone_input"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:padding="4dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/tv_enter_phone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Country Code -->
            <Button
                android:id="@+id/btn_country_code"
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:text="+27 🇿🇦"
                android:textColor="@color/vuka_text_primary"
                android:textSize="13sp"
                android:background="@android:color/transparent"
                android:contentDescription="Country code selector" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/input_border"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <!-- Phone number field -->
            <EditText
                android:id="@+id/et_phone_number"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="71 123 4567"
                android:textColor="@color/vuka_text_primary"
                android:textColorHint="@color/vuka_text_hint"
                android:textSize="16sp"
                android:inputType="phone"
                android:background="@android:color/transparent"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:importantForAutofill="no"
                android:contentDescription="Enter phone number" />
        </LinearLayout>

        <!-- Error text -->
        <TextView
            android:id="@+id/tv_phone_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/risk_high"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/ll_phone_input"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Request OTP Button -->
        <Button
            android:id="@+id/btn_request_otp"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/request_otp"
            android:textColor="@color/vuka_navy_dark"
            android:textStyle="bold"
            android:textSize="16sp"
            android:background="@drawable/bg_button_primary"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/tv_phone_error"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Divider -->
        <TextView
            android:id="@+id/tv_or"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/or_sign_in_with"
            android:textColor="@color/vuka_text_hint"
            android:textSize="13sp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/btn_request_otp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Social sign-in row (Google/Apple — demo only) -->
        <LinearLayout
            android:id="@+id/ll_social"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tv_or"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/btn_google"
                android:layout_width="56dp"
                android:layout_height="52dp"
                android:text="G"
                android:textColor="@color/vuka_text_primary"
                android:textStyle="bold"
                android:textSize="20sp"
                android:background="@drawable/bg_card"
                android:layout_marginEnd="12dp"
                android:contentDescription="Sign in with Google (demo)" />

            <Button
                android:id="@+id/btn_apple"
                android:layout_width="56dp"
                android:layout_height="52dp"
                android:text="🍎"
                android:textSize="20sp"
                android:background="@drawable/bg_card"
                android:contentDescription="Sign in with Apple (demo)" />
        </LinearLayout>

        <!-- Terms and Privacy -->
        <TextView
            android:id="@+id/tv_terms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="By continuing, you agree to our Terms of Service and Privacy Policy"
            android:textColor="@color/vuka_text_hint"
            android:textSize="11sp"
            android:textAlignment="center"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toBottomOf="@id/ll_social"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

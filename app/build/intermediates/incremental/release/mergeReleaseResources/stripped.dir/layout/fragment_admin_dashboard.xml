<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vuka_navy_dark">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <!-- Header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="16dp" android:layout_marginTop="8dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/admin_dashboard"
                    android:textColor="@color/vuka_text_primary" android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Administrator Access" android:textColor="@color/vuka_gold"
                    android:textSize="12sp" />
            </LinearLayout>
            <Button android:id="@+id/btn_admin_logout"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="Logout" android:textColor="@color/sos_red" android:textSize="13sp"
                android:background="@drawable/bg_card"
                android:contentDescription="Logout from admin" />
        </LinearLayout>

        <!-- Demo notice -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="ADMIN DEMO — All data is simulated"
            android:textColor="@color/vuka_text_primary" android:textSize="11sp"
            android:textAlignment="center" android:gravity="center"
            android:background="@drawable/bg_demo_banner" android:padding="8dp"
            android:layout_marginBottom="16dp" />

        <!-- KPI Cards Row 1 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">

            <androidx.cardview.widget.CardView android:id="@+id/card_kpi_active_trips"
                android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1"
                android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"
                android:contentDescription="Active trips KPI"
                app:cardBackgroundColor="@color/card_bg" app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center" android:padding="8dp">
                    <TextView android:id="@+id/tv_kpi_active_trips"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="47" android:textColor="@color/vuka_gold"
                        android:textSize="26sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Active Trips" android:textColor="@color/vuka_text_secondary"
                        android:textSize="11sp" android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:id="@+id/card_kpi_pending_reports"
                android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1"
                android:clickable="true" android:focusable="true"
                android:contentDescription="Pending reports KPI"
                app:cardBackgroundColor="@color/card_bg" app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center" android:padding="8dp">
                    <TextView android:id="@+id/tv_kpi_pending_reports"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="12" android:textColor="@color/risk_elevated"
                        android:textSize="26sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Pending Reports" android:textColor="@color/vuka_text_secondary"
                        android:textSize="11sp" android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- KPI Cards Row 2 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="16dp">

            <androidx.cardview.widget.CardView android:id="@+id/card_kpi_emergency"
                android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1"
                android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"
                android:contentDescription="Emergency alerts KPI"
                app:cardBackgroundColor="@color/card_bg" app:cardCornerRadius="12dp"
                app:strokeColor="@color/sos_red" app:strokeWidth="1dp"
                app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center" android:padding="8dp">
                    <TextView android:id="@+id/tv_kpi_emergency"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="2" android:textColor="@color/sos_red"
                        android:textSize="26sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Emergency Alerts" android:textColor="@color/vuka_text_secondary"
                        android:textSize="11sp" android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:id="@+id/card_kpi_hotspots"
                android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1"
                android:clickable="true" android:focusable="true"
                android:contentDescription="Incident hotspots KPI"
                app:cardBackgroundColor="@color/card_bg" app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center" android:padding="8dp">
                    <TextView android:id="@+id/tv_kpi_hotspots"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="8" android:textColor="@color/risk_moderate"
                        android:textSize="26sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Incident Hotspots" android:textColor="@color/vuka_text_secondary"
                        android:textSize="11sp" android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Report Moderation Section -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/report_moderation"
                android:textColor="@color/vuka_text_primary" android:textSize="16sp"
                android:textStyle="bold" />
            <Button android:id="@+id/btn_filter_reports"
                android:layout_width="wrap_content" android:layout_height="32dp"
                android:text="Filter" android:textColor="@color/vuka_text_primary"
                android:textSize="12sp" android:background="@drawable/bg_card"
                android:contentDescription="Filter reports" />
        </LinearLayout>

        <!-- Filter chips -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_filter"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <com.google.android.material.chip.Chip android:id="@+id/chip_all"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="All" style="@style/Widget.MaterialComponents.Chip.Choice"
                android:textColor="@color/vuka_text_primary" app:chipBackgroundColor="@color/vuka_gold"
                android:contentDescription="Show all reports" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_new_reports"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="New" style="@style/Widget.MaterialComponents.Chip.Choice"
                android:textColor="@color/vuka_text_primary" app:chipBackgroundColor="@color/card_bg"
                android:contentDescription="Show new reports" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_reviewed_reports"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Reviewed" style="@style/Widget.MaterialComponents.Chip.Choice"
                android:textColor="@color/vuka_text_primary" app:chipBackgroundColor="@color/card_bg"
                android:contentDescription="Show reviewed reports" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_verified_reports"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Verified" style="@style/Widget.MaterialComponents.Chip.Choice"
                android:textColor="@color/vuka_text_primary" app:chipBackgroundColor="@color/card_bg"
                android:contentDescription="Show verified reports" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Reports RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_admin_reports"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="16dp" />

        <!-- Driver Verification Section -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/driver_verification_queue"
                android:textColor="@color/vuka_text_primary" android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_driver_verification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="16dp" />

        <!-- Audit Logs Section -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/audit_logs"
                android:textColor="@color/vuka_text_primary" android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_audit_logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vuka_navy_dark">

    <!-- Map Simulation (70% height) -->
    <com.vuka.app.utils.MapSimulationView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.7"
        android:contentDescription="Active trip map simulation" />

    <!-- Map overlay — demo label -->
    <TextView
        android:id="@+id/tv_map_demo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MAP SIMULATION — Not real GPS"
        android:textColor="@color/vuka_text_primary"
        android:textSize="10sp"
        android:background="@drawable/bg_card"
        android:padding="6dp"
        android:layout_margin="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Map top controls -->
    <LinearLayout
        android:id="@+id/ll_map_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_back_monitoring"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="@drawable/bg_card"
            android:contentDescription="Go back"
            android:padding="8dp" />
    </LinearLayout>

    <!-- ETA Chip on map -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_eta_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/vuka_navy_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="10dp" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ETA: " android:textColor="@color/vuka_text_secondary" android:textSize="13sp" />
            <TextView android:id="@+id/tv_eta"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="6 min" android:textColor="@color/vuka_gold"
                android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Bottom Panel (30% approx) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:cardBackgroundColor="@color/vuka_navy_card"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/map_view"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Driver Info Row -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView android:layout_width="44dp" android:layout_height="44dp"
                    android:text="TM" android:textColor="@color/vuka_gold"
                    android:textStyle="bold" android:textSize="14sp"
                    android:gravity="center" android:background="@drawable/bg_avatar_circle" />

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView android:id="@+id/tv_driver_name"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Driver: Thabo Mokoena"
                        android:textColor="@color/vuka_text_primary" android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView android:id="@+id/tv_vehicle_info"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Toyota Corolla · CA 123-456"
                        android:textColor="@color/vuka_text_secondary" android:textSize="12sp" />
                </LinearLayout>

                <TextView android:id="@+id/tv_risk_status_monitoring"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="LOW RISK" android:textColor="@color/risk_low"
                    android:textSize="12sp" android:textStyle="bold"
                    android:background="@drawable/bg_risk_low" android:padding="8dp" />
            </LinearLayout>

            <!-- Action Buttons Row -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/btn_sos_monitoring"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:text="🆘 SOS"
                    android:textColor="@color/white" android:textStyle="bold" android:textSize="13sp"
                    android:background="@drawable/bg_sos_button" android:layout_marginEnd="6dp"
                    android:contentDescription="@string/content_desc_sos_button" />

                <Button android:id="@+id/btn_share_trip"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:text="📤 Share"
                    android:textColor="@color/vuka_text_primary" android:textSize="13sp"
                    android:background="@drawable/bg_button_secondary" android:layout_marginEnd="6dp"
                    android:contentDescription="Share this trip with contacts" />

                <Button android:id="@+id/btn_report_monitoring"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:text="⚠ Report"
                    android:textColor="@color/risk_elevated" android:textSize="13sp"
                    android:background="@drawable/bg_card"
                    android:contentDescription="Report an incident" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>

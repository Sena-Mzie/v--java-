<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vuka_navy_dark">

    <!-- Header -->
    <LinearLayout android:id="@+id/ll_header"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="16dp" android:paddingTop="24dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton android:id="@+id/btn_back_reports"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="@drawable/bg_card"
            android:contentDescription="@string/content_desc_back" android:padding="8dp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/report_history"
            android:textColor="@color/vuka_text_primary" android:textSize="20sp"
            android:textStyle="bold" android:gravity="center" android:layout_marginStart="8dp" />
        <Button android:id="@+id/btn_new_report"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="+ New" android:textColor="@color/vuka_navy_dark"
            android:textSize="13sp" android:background="@drawable/bg_button_primary"
            android:contentDescription="Create a new incident report" />
    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout android:id="@+id/ll_empty_reports"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:orientation="vertical" android:gravity="center"
        android:padding="32dp" android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ll_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="📋" android:textSize="48sp" android:gravity="center" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/no_reports_yet"
            android:textColor="@color/vuka_text_secondary" android:textSize="16sp"
            android:textStyle="bold" android:gravity="center" android:layout_marginTop="12dp" />
    </LinearLayout>

    <!-- Reports List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_reports"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/ll_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

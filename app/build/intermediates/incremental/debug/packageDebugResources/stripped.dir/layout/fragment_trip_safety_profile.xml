<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vuka_navy_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="16dp" android:layout_marginTop="8dp">
            <ImageButton android:id="@+id/btn_back_profile"
                android:layout_width="40dp" android:layout_height="40dp"
                android:src="@android:drawable/ic_media_previous"
                android:background="@drawable/bg_card"
                android:contentDescription="@string/content_desc_back" android:padding="8dp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/trip_safety_profile"
                android:textColor="@color/vuka_text_primary" android:textSize="18sp"
                android:textStyle="bold" android:gravity="center" android:layout_marginStart="8dp" />
            <View android:layout_width="40dp" android:layout_height="40dp" />
        </LinearLayout>

        <!-- Illustrative Data Warning Banner -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/illustrative_data_note"
            android:textColor="@color/vuka_text_primary"
            android:textSize="11sp"
            android:textAlignment="center"
            android:gravity="center"
            android:background="@drawable/bg_demo_banner"
            android:padding="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Overall Risk Score Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_overall_risk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/risk_low"
            app:strokeWidth="2dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_overall_risk_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/overall_risk"
                    android:textColor="@color/vuka_text_secondary"
                    android:textSize="13sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tv_risk_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="92"
                    android:textColor="@color/risk_low"
                    android:textSize="64sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/tv_overall_risk_label"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tv_risk_level_badge" />

                <TextView
                    android:id="@+id/tv_risk_score_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Safety Score"
                    android:textColor="@color/vuka_text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/tv_risk_score"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tv_risk_level_badge" />

                <TextView
                    android:id="@+id/tv_risk_level_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOW RISK"
                    android:textColor="@color/risk_low"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:padding="12dp"
                    android:background="@drawable/bg_risk_low"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pickup Risk -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_pickup_risk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="📍 @string/pickup_risk"
                        android:textColor="@color/vuka_text_primary" android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView android:id="@+id/tv_pickup_risk_badge"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="LOW" android:textColor="@color/risk_low"
                        android:textSize="12sp" android:textStyle="bold"
                        android:background="@drawable/bg_risk_low" android:padding="8dp" />
                </LinearLayout>
                <TextView android:id="@+id/tv_pickup_risk_desc"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Area is generally well-lit and active. Pickup point is in a commercial zone."
                    android:textColor="@color/vuka_text_secondary" android:textSize="13sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Route Risk -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_route_risk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="🛣 @string/route_risk"
                        android:textColor="@color/vuka_text_primary" android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView android:id="@+id/tv_route_risk_badge"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="LOW" android:textColor="@color/risk_low"
                        android:textSize="12sp" android:textStyle="bold"
                        android:background="@drawable/bg_risk_low" android:padding="8dp" />
                </LinearLayout>
                <TextView android:id="@+id/tv_route_risk_desc"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Route passes through 2 high-traffic areas. No major incidents in last 48h."
                    android:textColor="@color/vuka_text_secondary" android:textSize="13sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Destination Risk -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_destination_risk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="🏁 @string/destination_risk"
                        android:textColor="@color/vuka_text_primary" android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView android:id="@+id/tv_dest_risk_badge"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="LOW" android:textColor="@color/risk_low"
                        android:textSize="12sp" android:textStyle="bold"
                        android:background="@drawable/bg_risk_low" android:padding="8dp" />
                </LinearLayout>
                <TextView android:id="@+id/tv_dest_risk_desc"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Sandton CBD — well-patrolled commercial district with 24h security."
                    android:textColor="@color/vuka_text_secondary" android:textSize="13sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Risk Factors (expandable) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_risk_factors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/risk_factors"
                        android:textColor="@color/vuka_text_primary" android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView android:id="@+id/tv_expand_factors"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="▼" android:textColor="@color/vuka_gold" android:textSize="16sp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ll_risk_factors_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_risk_factors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Safer Route Recommendation Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_safer_route"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/risk_low"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✅ @string/safer_route_available"
                    android:textColor="@color/risk_low" android:textSize="15sp"
                    android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="10dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Original Route" android:textColor="@color/vuka_text_secondary"
                            android:textSize="11sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="28 min" android:textColor="@color/vuka_text_primary"
                            android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Safer Route" android:textColor="@color/vuka_text_secondary"
                            android:textSize="11sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="25 min" android:textColor="@color/risk_low"
                            android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Risk Difference" android:textColor="@color/vuka_text_secondary"
                            android:textSize="11sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="-12%" android:textColor="@color/risk_low"
                            android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="12dp">
                    <Button android:id="@+id/btn_use_safer_route"
                        android:layout_width="0dp" android:layout_height="44dp"
                        android:layout_weight="1" android:text="@string/use_safer_route"
                        android:textColor="@color/vuka_navy_dark" android:textSize="13sp"
                        android:textStyle="bold" android:background="@drawable/bg_button_primary"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Use the safer route" />
                    <Button android:id="@+id/btn_keep_original"
                        android:layout_width="0dp" android:layout_height="44dp"
                        android:layout_weight="1" android:text="@string/keep_original"
                        android:textColor="@color/vuka_text_secondary" android:textSize="13sp"
                        android:background="@drawable/bg_button_secondary"
                        android:contentDescription="Keep original route" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Start Trip Button -->
        <Button
            android:id="@+id/btn_start_trip"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Start Trip"
            android:textColor="@color/vuka_navy_dark"
            android:textStyle="bold"
            android:textSize="16sp"
            android:background="@drawable/bg_button_primary"
            android:layout_marginBottom="24dp"
            android:contentDescription="Start the trip and begin monitoring" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

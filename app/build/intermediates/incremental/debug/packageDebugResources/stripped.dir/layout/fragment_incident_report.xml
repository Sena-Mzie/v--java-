<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vuka_navy_dark"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/ll_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toTopOf="parent">
            <ImageButton android:id="@+id/btn_back_incident"
                android:layout_width="40dp" android:layout_height="40dp"
                android:src="@android:drawable/ic_media_previous"
                android:background="@drawable/bg_card"
                android:contentDescription="@string/content_desc_back" android:padding="8dp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/report_incident_title"
                android:textColor="@color/vuka_text_primary" android:textSize="20sp"
                android:textStyle="bold" android:gravity="center" android:layout_marginStart="8dp" />
            <View android:layout_width="40dp" android:layout_height="40dp" />
        </LinearLayout>

        <!-- Incident Type Selection -->
        <TextView android:id="@+id/tv_type_label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/incident_type" android:textColor="@color/vuka_text_secondary"
            android:textSize="13sp" android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/ll_header"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_incident_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tv_type_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_suspicious"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Suspicious Activity"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:textColor="@color/vuka_text_primary"
                app:chipBackgroundColor="@color/card_bg"
                app:chipStrokeColor="@color/card_border"
                app:chipStrokeWidth="1dp"
                android:contentDescription="Select Suspicious Activity incident type" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_robbery"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Robbery"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:textColor="@color/vuka_text_primary"
                app:chipBackgroundColor="@color/card_bg"
                app:chipStrokeColor="@color/card_border"
                app:chipStrokeWidth="1dp"
                android:contentDescription="Select Robbery incident type" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_hijacking"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Hijacking"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:textColor="@color/vuka_text_primary"
                app:chipBackgroundColor="@color/card_bg"
                app:chipStrokeColor="@color/card_border"
                app:chipStrokeWidth="1dp"
                android:contentDescription="Select Hijacking incident type" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_unsafe_dropoff"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Unsafe Drop-off"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:textColor="@color/vuka_text_primary"
                app:chipBackgroundColor="@color/card_bg"
                app:chipStrokeColor="@color/card_border"
                app:chipStrokeWidth="1dp"
                android:contentDescription="Select Unsafe Drop-off incident type" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_road_blocked"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Road Blocked"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:textColor="@color/vuka_text_primary"
                app:chipBackgroundColor="@color/card_bg"
                app:chipStrokeColor="@color/card_border"
                app:chipStrokeWidth="1dp"
                android:contentDescription="Select Road Blocked incident type" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_other"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Other"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:textColor="@color/vuka_text_primary"
                app:chipBackgroundColor="@color/card_bg"
                app:chipStrokeColor="@color/card_border"
                app:chipStrokeWidth="1dp"
                android:contentDescription="Select Other incident type" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Location -->
        <TextView android:id="@+id/tv_location_label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/incident_location" android:textColor="@color/vuka_text_secondary"
            android:textSize="13sp" android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/chip_group_incident_type"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout android:id="@+id/ll_location_buttons"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tv_location_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button android:id="@+id/btn_use_current_location"
                android:layout_width="0dp" android:layout_height="44dp"
                android:layout_weight="1" android:text="📍 Current Location"
                android:textColor="@color/vuka_text_primary" android:textSize="13sp"
                android:background="@drawable/bg_card" android:layout_marginEnd="8dp"
                android:contentDescription="Use current GPS location" />

            <Button android:id="@+id/btn_select_on_map"
                android:layout_width="0dp" android:layout_height="44dp"
                android:layout_weight="1" android:text="🗺 Select on Map"
                android:textColor="@color/vuka_text_primary" android:textSize="13sp"
                android:background="@drawable/bg_card"
                android:contentDescription="Select incident location on map" />
        </LinearLayout>

        <!-- Selected Location display -->
        <TextView android:id="@+id/tv_selected_location"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="📍 Sandton Drive, Sandton (simulated)"
            android:textColor="@color/vuka_gold" android:textSize="13sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/ll_location_buttons"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Photo Upload -->
        <TextView android:id="@+id/tv_photo_label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/add_photo" android:textColor="@color/vuka_text_secondary"
            android:textSize="13sp" android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tv_selected_location"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout android:id="@+id/ll_photo_upload"
            android:layout_width="match_parent" android:layout_height="80dp"
            android:orientation="horizontal" android:gravity="center"
            android:background="@drawable/bg_card" android:layout_marginTop="8dp"
            android:clickable="true" android:focusable="true"
            android:contentDescription="Tap to add incident photo"
            app:layout_constraintTop_toBottomOf="@id/tv_photo_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <TextView android:id="@+id/tv_add_photo_icon"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📷" android:textSize="28sp" android:layout_marginEnd="12dp" />
            <TextView android:id="@+id/tv_add_photo_label"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Tap to add photo" android:textColor="@color/vuka_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Photo preview -->
        <ImageView android:id="@+id/iv_incident_photo"
            android:layout_width="match_parent" android:layout_height="120dp"
            android:scaleType="centerCrop" android:visibility="gone"
            android:contentDescription="Incident photo preview"
            app:layout_constraintTop_toBottomOf="@id/ll_photo_upload"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Description -->
        <TextView android:id="@+id/tv_desc_label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/description" android:textColor="@color/vuka_text_secondary"
            android:textSize="13sp" android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/iv_incident_photo"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText android:id="@+id/et_description"
            android:layout_width="match_parent" android:layout_height="100dp"
            android:hint="Describe what happened…"
            android:textColor="@color/vuka_text_primary"
            android:textColorHint="@color/vuka_text_hint"
            android:textSize="14sp"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:layout_marginTop="8dp"
            android:importantForAutofill="no"
            android:contentDescription="Incident description"
            app:layout_constraintTop_toBottomOf="@id/tv_desc_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Error text -->
        <TextView android:id="@+id/tv_incident_error"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/risk_high" android:textSize="13sp"
            android:layout_marginTop="8dp" android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/et_description"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Submit Button -->
        <Button android:id="@+id/btn_submit_report"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="@string/submit_report"
            android:textColor="@color/vuka_navy_dark" android:textStyle="bold"
            android:textSize="16sp" android:background="@drawable/bg_button_primary"
            android:layout_marginTop="16dp" android:layout_marginBottom="24dp"
            android:contentDescription="Submit incident report"
            app:layout_constraintTop_toBottomOf="@id/tv_incident_error"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

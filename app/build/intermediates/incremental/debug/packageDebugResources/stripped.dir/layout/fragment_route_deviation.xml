<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vuka_navy_dark"
    android:padding="24dp">

    <!-- Alert Icon -->
    <TextView android:id="@+id/tv_deviation_icon"
        android:layout_width="80dp" android:layout_height="80dp"
        android:text="⚠" android:textSize="48sp" android:gravity="center"
        android:background="@drawable/bg_risk_elevated"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Alert Title -->
    <TextView android:id="@+id/tv_deviation_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/route_change_detected"
        android:textColor="@color/risk_elevated" android:textSize="24sp"
        android:textStyle="bold" android:textAlignment="center" android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_deviation_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subtitle -->
    <TextView android:id="@+id/tv_deviation_subtitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/is_everything_ok"
        android:textColor="@color/vuka_text_primary" android:textSize="18sp"
        android:textAlignment="center" android:gravity="center"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_deviation_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Map deviation preview -->
    <androidx.cardview.widget.CardView android:id="@+id/card_deviation_map"
        android:layout_width="match_parent" android:layout_height="140dp"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/map_bg" app:cardCornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_deviation_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
            <com.vuka.app.utils.MapSimulationView
                android:id="@+id/map_deviation"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:contentDescription="Route deviation map simulation" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="bottom|end" android:layout_margin="6dp"
                android:text="DEVIATION DETECTED" android:textColor="@color/risk_elevated"
                android:textSize="9sp" android:textStyle="bold"
                android:background="@drawable/bg_card" android:padding="4dp" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Options -->
    <LinearLayout android:id="@+id/ll_deviation_options"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/card_deviation_map"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button android:id="@+id/btn_im_ok"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:text="@string/im_ok"
            android:textColor="@color/vuka_navy_dark" android:textStyle="bold"
            android:textSize="18sp" android:background="@drawable/bg_button_primary"
            android:layout_marginBottom="10dp"
            android:contentDescription="Confirm I am safe and OK" />

        <Button android:id="@+id/btn_expected_detour"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="@string/expected_detour"
            android:textColor="@color/vuka_text_primary" android:textSize="16sp"
            android:background="@drawable/bg_button_secondary"
            android:layout_marginBottom="10dp"
            android:contentDescription="This is an expected detour" />

        <Button android:id="@+id/btn_need_help_deviation"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="@string/i_need_help"
            android:textColor="@color/white" android:textStyle="bold"
            android:textSize="16sp" android:background="@drawable/bg_sos_button"
            android:contentDescription="I need help — activates emergency SOS" />
    </LinearLayout>

    <!-- Timer note -->
    <TextView android:id="@+id/tv_auto_response_timer"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Auto-escalating in 60 seconds if no response"
        android:textColor="@color/risk_elevated" android:textSize="12sp"
        android:textAlignment="center" android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/ll_deviation_options"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

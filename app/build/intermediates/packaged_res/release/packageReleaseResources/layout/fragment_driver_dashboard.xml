<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vuka_navy_dark">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Row -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/ll_greeting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/ll_header_right"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:id="@+id/tv_greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Good Morning,"
                        android:textColor="@color/vuka_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_username"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thabo Mokoena"
                        android:textColor="@color/vuka_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_header_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <ImageButton
                        android:id="@+id/btn_notifications"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_dialog_info"
                        android:background="@drawable/bg_card"
                        android:contentDescription="Notifications"
                        android:padding="8dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tv_avatar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="TM"
                        android:textColor="@color/vuka_gold"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:background="@drawable/bg_avatar_circle"
                        android:contentDescription="User avatar — tap to open profile" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Safety Status Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_safety_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/risk_low"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_vuka_shield"
                        android:contentDescription="Safety shield" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/safety_status"
                            android:textColor="@color/vuka_text_secondary"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/tv_safety_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/excellent"
                            android:textColor="@color/risk_low"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_safety_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="98"
                        android:textColor="@color/risk_low"
                        android:textSize="32sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Quick Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- New Trip -->
                <LinearLayout
                    android:id="@+id/btn_new_trip"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Create a new trip">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🚗" android:textSize="24sp" android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="New Trip" android:textColor="@color/vuka_text_primary"
                        android:textSize="11sp" android:layout_marginTop="4dp" android:gravity="center" />
                </LinearLayout>

                <!-- Verify Driver -->
                <LinearLayout
                    android:id="@+id/btn_verify_driver_quick"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Verify driver">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🔍" android:textSize="24sp" android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Verify\nDriver" android:textColor="@color/vuka_text_primary"
                        android:textSize="11sp" android:layout_marginTop="4dp" android:gravity="center"
                        android:textAlignment="center" />
                </LinearLayout>

                <!-- Trusted Contacts -->
                <LinearLayout
                    android:id="@+id/btn_trusted_contacts_quick"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Trusted contacts">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="👥" android:textSize="24sp" android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Trusted\nContacts" android:textColor="@color/vuka_text_primary"
                        android:textSize="11sp" android:layout_marginTop="4dp" android:gravity="center"
                        android:textAlignment="center" />
                </LinearLayout>

                <!-- Emergency SOS quick -->
                <LinearLayout
                    android:id="@+id/btn_sos_quick"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_risk_high"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/content_desc_sos_button">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🆘" android:textSize="24sp" android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Emergency\nSOS" android:textColor="@color/sos_red"
                        android:textSize="11sp" android:layout_marginTop="4dp" android:gravity="center"
                        android:textAlignment="center" android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Today's Trips Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_todays_trips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="View today's trips"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/todays_trips"
                            android:textColor="@color/vuka_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tv_trips_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3"
                            android:textColor="@color/vuka_gold"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Johannesburg CBD → Sandton"
                        android:textColor="@color/vuka_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last trip: 10:30 AM  |  Risk: LOW"
                        android:textColor="@color/risk_low"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Safety Insights Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_safety_insights"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="View safety insights"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/safety_insights"
                            android:textColor="@color/vuka_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="→"
                            android:textColor="@color/vuka_gold"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="12" android:textColor="@color/risk_low"
                                android:textSize="22sp" android:textStyle="bold" android:gravity="center" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Safe Trips" android:textColor="@color/vuka_text_secondary"
                                android:textSize="11sp" android:gravity="center" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="2" android:textColor="@color/risk_elevated"
                                android:textSize="22sp" android:textStyle="bold" android:gravity="center" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Alerts" android:textColor="@color/vuka_text_secondary"
                                android:textSize="11sp" android:gravity="center" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="95%" android:textColor="@color/vuka_gold"
                                android:textSize="22sp" android:textStyle="bold" android:gravity="center" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Safety Score" android:textColor="@color/vuka_text_secondary"
                                android:textSize="11sp" android:gravity="center" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Incident Hotspots Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_hotspots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="View incident hotspots"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/incident_hotspots"
                            android:textColor="@color/vuka_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="→"
                            android:textColor="@color/vuka_gold"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔴 Bree St / Noord St — HIGH activity"
                        android:textColor="@color/risk_high"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🟡 Sandton Drive — MODERATE activity"
                        android:textColor="@color/risk_moderate"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠ ILLUSTRATIVE DATA — Not verified intelligence"
                        android:textColor="@color/vuka_text_hint"
                        android:textSize="10sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Recent Alerts Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_recent_alerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="View recent alerts"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/recent_alerts"
                            android:textColor="@color/vuka_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tv_alerts_badge"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:text="2"
                            android:textColor="@color/vuka_navy_dark"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:background="@drawable/bg_button_primary" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_alerts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Persistent SOS FAB -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_sos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="SOS"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:backgroundTint="@color/sos_red"
        android:contentDescription="@string/content_desc_sos_button"
        app:icon="@android:drawable/ic_dialog_alert"
        app:iconTint="@color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vuka_navy_dark">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <!-- Demo Access Banner -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/secure_demo_access"
            android:textColor="@color/vuka_text_primary" android:textSize="11sp"
            android:textAlignment="center" android:gravity="center"
            android:background="@drawable/bg_demo_banner" android:padding="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            <ImageView android:layout_width="40dp" android:layout_height="40dp"
                android:src="@drawable/ic_vuka_shield" android:contentDescription="VUKA logo" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="VUKA Live Tracking"
                    android:textColor="@color/vuka_text_primary" android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Trusted Contact View"
                    android:textColor="@color/vuka_text_secondary" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:id="@+id/tv_live_status_badge"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🟢 LIVE" android:textColor="@color/risk_low"
                android:textSize="12sp" android:textStyle="bold"
                android:background="@drawable/bg_risk_low" android:padding="8dp" />
        </LinearLayout>

        <!-- Traveller Info Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card_bg" app:cardCornerRadius="16dp"
            app:strokeColor="@color/card_border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Traveller" android:textColor="@color/vuka_text_secondary"
                    android:textSize="12sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="6dp">
                    <TextView android:layout_width="44dp" android:layout_height="44dp"
                        android:text="JD" android:textColor="@color/vuka_gold"
                        android:textStyle="bold" android:textSize="14sp"
                        android:gravity="center" android:background="@drawable/bg_avatar_circle"
                        android:layout_marginEnd="12dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/tv_live_traveller_name"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Jane Doe"
                            android:textColor="@color/vuka_text_primary" android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView android:id="@+id/tv_live_trip_id"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Trip ID: TRP-2024-001"
                            android:textColor="@color/vuka_text_secondary" android:textSize="12sp" />
                    </LinearLayout>
                    <TextView android:id="@+id/tv_live_trip_status"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Normal" android:textColor="@color/risk_low"
                        android:textSize="12sp" android:textStyle="bold"
                        android:background="@drawable/bg_risk_low" android:padding="8dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Map Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="200dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/map_bg" app:cardCornerRadius="16dp">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <com.vuka.app.utils.MapSimulationView
                    android:id="@+id/map_live"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:contentDescription="Live trip map simulation" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end" android:layout_margin="8dp"
                    android:text="SIMULATED — Not real GPS"
                    android:textColor="@color/vuka_text_hint" android:textSize="9sp"
                    android:background="@drawable/bg_card" android:padding="4dp" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- Trip Details -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card_bg" app:cardCornerRadius="16dp"
            app:strokeColor="@color/card_border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Trip Details" android:textColor="@color/vuka_gold"
                    android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📍 " android:textSize="14sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Johannesburg CBD"
                        android:textColor="@color/vuka_text_primary" android:textSize="13sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🏁 " android:textSize="14sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Sandton City"
                        android:textColor="@color/vuka_text_primary" android:textSize="13sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⏱ ETA: " android:textColor="@color/vuka_text_secondary"
                        android:textSize="13sp" />
                    <TextView android:id="@+id/tv_live_eta"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="6 minutes" android:textColor="@color/vuka_gold"
                        android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Driver and Vehicle Info -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_bg" app:cardCornerRadius="16dp"
            app:strokeColor="@color/card_border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Driver &amp; Vehicle" android:textColor="@color/vuka_gold"
                    android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="44dp" android:layout_height="44dp"
                        android:text="TM" android:textColor="@color/vuka_gold"
                        android:textStyle="bold" android:textSize="14sp"
                        android:gravity="center" android:background="@drawable/bg_avatar_circle"
                        android:layout_marginEnd="12dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Thabo Mokoena"
                            android:textColor="@color/vuka_text_primary" android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Toyota Corolla · CA 123-456"
                            android:textColor="@color/vuka_text_secondary" android:textSize="12sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Platform: Uber"
                            android:textColor="@color/vuka_text_secondary" android:textSize="11sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="✅ Verified" android:textColor="@color/status_verified"
                        android:textSize="12sp" android:textStyle="bold"
                        android:background="@drawable/bg_risk_low" android:padding="8dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vuka_navy_dark"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout android:id="@+id/ll_header"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toTopOf="parent">
            <ImageButton android:id="@+id/btn_back_driver"
                android:layout_width="40dp" android:layout_height="40dp"
                android:src="@android:drawable/ic_media_previous"
                android:background="@drawable/bg_card"
                android:contentDescription="@string/content_desc_back" android:padding="8dp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/driver_registration"
                android:textColor="@color/vuka_text_primary" android:textSize="20sp"
                android:textStyle="bold" android:gravity="center" android:layout_marginStart="8dp" />
            <View android:layout_width="40dp" android:layout_height="40dp" />
        </LinearLayout>

        <!-- Step indicator -->
        <LinearLayout android:id="@+id/ll_steps"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/ll_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center" android:layout_marginEnd="8dp">
                <TextView android:id="@+id/step1_circle" android:layout_width="28dp"
                    android:layout_height="28dp" android:text="1" android:textSize="12sp"
                    android:textStyle="bold" android:gravity="center"
                    android:background="@drawable/bg_button_primary"
                    android:textColor="@color/vuka_navy_dark" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Personal" android:textColor="@color/vuka_gold"
                    android:textSize="10sp" android:layout_marginTop="2dp" />
            </LinearLayout>

            <View android:layout_width="30dp" android:layout_height="2dp"
                android:background="@color/card_border" android:layout_marginBottom="12dp" />

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center" android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp">
                <TextView android:id="@+id/step2_circle" android:layout_width="28dp"
                    android:layout_height="28dp" android:text="2" android:textSize="12sp"
                    android:textStyle="bold" android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:textColor="@color/vuka_text_secondary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Vehicle" android:textColor="@color/vuka_text_secondary"
                    android:textSize="10sp" android:layout_marginTop="2dp" />
            </LinearLayout>

            <View android:layout_width="30dp" android:layout_height="2dp"
                android:background="@color/card_border" android:layout_marginBottom="12dp" />

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center" android:layout_marginStart="8dp">
                <TextView android:id="@+id/step3_circle" android:layout_width="28dp"
                    android:layout_height="28dp" android:text="3" android:textSize="12sp"
                    android:textStyle="bold" android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:textColor="@color/vuka_text_secondary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Docs" android:textColor="@color/vuka_text_secondary"
                    android:textSize="10sp" android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section: Personal Details -->
        <TextView android:id="@+id/tv_personal_section"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/personal_details"
            android:textColor="@color/vuka_gold" android:textSize="15sp"
            android:textStyle="bold" android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/ll_steps"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Full Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_full_name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/full_name"
            style="@style/Widget.Vuka.TextInput"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tv_personal_section"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_full_name" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/vuka_text_primary"
                android:textSize="14sp" android:importantForAutofill="no"
                android:inputType="textPersonName"
                android:contentDescription="Enter your full name" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ID Number -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_id_number"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/sa_id_or_passport"
            style="@style/Widget.Vuka.TextInput"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/til_full_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_id_number" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/vuka_text_primary"
                android:textSize="14sp" android:importantForAutofill="no"
                android:inputType="text"
                android:contentDescription="Enter SA ID or passport number" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Driver Photo -->
        <TextView android:id="@+id/tv_photo_section"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/driver_photo"
            android:textColor="@color/vuka_gold" android:textSize="15sp"
            android:textStyle="bold" android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/til_id_number"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout android:id="@+id/ll_photo_capture"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/tv_photo_section"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView android:id="@+id/iv_driver_photo"
                android:layout_width="80dp" android:layout_height="80dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_my_calendar"
                android:background="@drawable/bg_avatar_circle"
                android:contentDescription="Driver profile photo"
                android:layout_marginEnd="12dp" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:gravity="center_vertical">
                <Button android:id="@+id/btn_take_photo"
                    android:layout_width="match_parent" android:layout_height="40dp"
                    android:text="📷 Take Photo" android:textColor="@color/vuka_text_primary"
                    android:textSize="13sp" android:background="@drawable/bg_card"
                    android:layout_marginBottom="6dp"
                    android:contentDescription="Take a photo with camera" />
                <Button android:id="@+id/btn_choose_gallery"
                    android:layout_width="match_parent" android:layout_height="40dp"
                    android:text="🖼 Gallery" android:textColor="@color/vuka_text_primary"
                    android:textSize="13sp" android:background="@drawable/bg_button_secondary"
                    android:contentDescription="Choose photo from gallery" />
            </LinearLayout>
        </LinearLayout>

        <!-- Vehicle Details Section -->
        <TextView android:id="@+id/tv_vehicle_section"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/vehicle_details"
            android:textColor="@color/vuka_gold" android:textSize="15sp"
            android:textStyle="bold" android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/ll_photo_capture"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_reg_number"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/registration_number"
            style="@style/Widget.Vuka.TextInput"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tv_vehicle_section"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_reg_number" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/vuka_text_primary"
                android:textSize="14sp" android:importantForAutofill="no"
                android:inputType="textCapCharacters"
                android:contentDescription="Vehicle registration number" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout android:id="@+id/ll_make_model"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/til_reg_number"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:hint="@string/vehicle_make"
                style="@style/Widget.Vuka.TextInput" android:layout_marginEnd="8dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_vehicle_make" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="@color/vuka_text_primary"
                    android:textSize="14sp" android:importantForAutofill="no"
                    android:contentDescription="Vehicle make" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:hint="@string/vehicle_model"
                style="@style/Widget.Vuka.TextInput">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_vehicle_model" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="@color/vuka_text_primary"
                    android:textSize="14sp" android:importantForAutofill="no"
                    android:contentDescription="Vehicle model" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_colour"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/vehicle_colour"
            style="@style/Widget.Vuka.TextInput"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/ll_make_model"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_vehicle_colour" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/vuka_text_primary"
                android:textSize="14sp" android:importantForAutofill="no"
                android:contentDescription="Vehicle colour" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- E-hailing Platform Spinner -->
        <TextView android:id="@+id/tv_platform_label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/ehailing_platform" android:textColor="@color/vuka_text_secondary"
            android:textSize="13sp" android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/til_colour"
            app:layout_constraintStart_toStartOf="parent" />

        <Spinner android:id="@+id/spinner_platform"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:popupBackground="@color/card_bg"
            android:layout_marginTop="8dp"
            android:contentDescription="Select e-hailing platform"
            app:layout_constraintTop_toBottomOf="@id/tv_platform_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Verification Status -->
        <LinearLayout android:id="@+id/ll_verification_status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:background="@drawable/bg_status_pending"
            android:padding="12dp" android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/spinner_platform"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="⏳ " android:textSize="16sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Verification Status" android:textColor="@color/vuka_text_secondary"
                    android:textSize="11sp" />
                <TextView android:id="@+id/tv_verification_status"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/verification_pending"
                    android:textColor="@color/status_pending" android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Error text -->
        <TextView android:id="@+id/tv_driver_error"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/risk_high" android:textSize="13sp"
            android:layout_marginTop="8dp" android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/ll_verification_status"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Save & Continue Button -->
        <Button android:id="@+id/btn_save_driver"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="@string/save_continue"
            android:textColor="@color/vuka_navy_dark" android:textStyle="bold"
            android:textSize="16sp" android:background="@drawable/bg_button_primary"
            android:layout_marginTop="16dp" android:layout_marginBottom="24dp"
            android:contentDescription="Save driver profile and continue"
            app:layout_constraintTop_toBottomOf="@id/tv_driver_error"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

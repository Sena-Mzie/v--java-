<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vuka_navy_dark">

    <!-- Normal State (before SOS) -->
    <LinearLayout
        android:id="@+id/ll_normal_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="visible">

        <!-- SOS Button (press and hold) -->
        <com.vuka.app.utils.SosHoldButton
            android:id="@+id/btn_sos_hold"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:contentDescription="@string/content_desc_sos_button" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sos_hold_instruction"
            android:textColor="@color/vuka_text_secondary"
            android:textSize="14sp"
            android:textAlignment="center"
            android:gravity="center"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hold the SOS button for 2 seconds to activate emergency alert"
            android:textColor="@color/vuka_text_hint"
            android:textSize="12sp"
            android:textAlignment="center"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <!-- Accessible alternative -->
        <Button
            android:id="@+id/btn_sos_accessible"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Activate Emergency (Alternative)"
            android:textColor="@color/sos_red"
            android:textSize="14sp"
            android:background="@drawable/bg_card"
            android:layout_marginTop="40dp"
            android:contentDescription="Accessible alternative to activate emergency SOS" />

        <Button
            android:id="@+id/btn_cancel_sos_screen"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/cancel"
            android:textColor="@color/vuka_text_secondary"
            android:textSize="15sp"
            android:background="@android:color/transparent"
            android:layout_marginTop="8dp"
            android:contentDescription="Cancel and go back" />
    </LinearLayout>

    <!-- Emergency Active State -->
    <LinearLayout
        android:id="@+id/ll_emergency_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="@drawable/bg_emergency_active"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🆘"
            android:textSize="64sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_requested"
            android:textColor="@color/sos_red"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/emergency_active"
            android:textColor="@color/vuka_text_primary"
            android:textSize="16sp"
            android:textAlignment="center"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <!-- Status Items -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <LinearLayout android:id="@+id/ll_status_contacts"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <ProgressBar android:id="@+id/pb_contacts"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp" android:layout_height="20dp"
                    android:indeterminateTint="@color/vuka_gold"
                    android:layout_marginEnd="12dp" />
                <TextView android:id="@+id/tv_status_contacts"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Notifying contacts…"
                    android:textColor="@color/vuka_text_secondary" android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/ll_status_sms"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <ProgressBar android:id="@+id/pb_sms"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp" android:layout_height="20dp"
                    android:indeterminateTint="@color/vuka_gold"
                    android:layout_marginEnd="12dp" />
                <TextView android:id="@+id/tv_status_sms"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Sending SMS…"
                    android:textColor="@color/vuka_text_secondary" android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/ll_status_partner"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <ProgressBar android:id="@+id/pb_partner"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp" android:layout_height="20dp"
                    android:indeterminateTint="@color/vuka_gold"
                    android:layout_marginEnd="12dp" />
                <TextView android:id="@+id/tv_status_partner"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Notifying VUKA partner…"
                    android:textColor="@color/vuka_text_secondary" android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/ll_status_location"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ProgressBar android:id="@+id/pb_location"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp" android:layout_height="20dp"
                    android:indeterminateTint="@color/vuka_gold"
                    android:layout_marginEnd="12dp" />
                <TextView android:id="@+id/tv_status_location"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Activating location sharing…"
                    android:textColor="@color/vuka_text_secondary" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Demo notice -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/demo_notification_simulated"
            android:textColor="@color/vuka_text_hint"
            android:textSize="11sp"
            android:textAlignment="center"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <!-- Countdown timer -->
        <TextView
            android:id="@+id/tv_emergency_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="00:45"
            android:textColor="@color/sos_red"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:gravity="center"
            android:layout_marginTop="20dp" />

        <!-- Cancel Emergency -->
        <Button
            android:id="@+id/btn_cancel_emergency"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Cancel Emergency"
            android:textColor="@color/vuka_text_secondary"
            android:textSize="15sp"
            android:background="@drawable/bg_button_secondary"
            android:layout_marginTop="16dp"
            android:contentDescription="Cancel the emergency alert" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

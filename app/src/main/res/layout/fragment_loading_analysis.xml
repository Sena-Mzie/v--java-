<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vuka_navy_dark"
    android:padding="24dp">

    <ImageView android:id="@+id/iv_analyzing_logo"
        android:layout_width="80dp" android:layout_height="80dp"
        android:src="@drawable/ic_vuka_shield"
        android:contentDescription="Analyzing route"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tv_analysis_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.3" />

    <TextView android:id="@+id/tv_analysis_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/analyzing_route"
        android:textColor="@color/vuka_text_primary" android:textSize="20sp"
        android:textStyle="bold" android:textAlignment="center" android:gravity="center"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/iv_analyzing_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/ll_steps_analysis" />

    <!-- Analysis Steps -->
    <LinearLayout android:id="@+id/ll_steps_analysis"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/tv_analysis_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Step 1 -->
        <LinearLayout android:id="@+id/step_pickup"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:padding="12dp" android:background="@drawable/bg_card"
            android:layout_marginBottom="8dp">
            <ProgressBar android:id="@+id/pb_step1"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="20dp" android:layout_height="20dp"
                android:indeterminateTint="@color/vuka_gold"
                android:layout_marginEnd="12dp" />
            <TextView android:id="@+id/tv_step1"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/checking_pickup"
                android:textColor="@color/vuka_text_primary" android:textSize="14sp" />
        </LinearLayout>

        <!-- Step 2 -->
        <LinearLayout android:id="@+id/step_route"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:padding="12dp" android:background="@drawable/bg_card"
            android:layout_marginBottom="8dp" android:alpha="0.4">
            <ProgressBar android:id="@+id/pb_step2"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="20dp" android:layout_height="20dp"
                android:indeterminateTint="@color/vuka_text_hint"
                android:layout_marginEnd="12dp" />
            <TextView android:id="@+id/tv_step2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/analyzing_route_step"
                android:textColor="@color/vuka_text_secondary" android:textSize="14sp" />
        </LinearLayout>

        <!-- Step 3 -->
        <LinearLayout android:id="@+id/step_destination"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:padding="12dp" android:background="@drawable/bg_card"
            android:layout_marginBottom="8dp" android:alpha="0.4">
            <ProgressBar android:id="@+id/pb_step3"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="20dp" android:layout_height="20dp"
                android:indeterminateTint="@color/vuka_text_hint"
                android:layout_marginEnd="12dp" />
            <TextView android:id="@+id/tv_step3"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/checking_destination"
                android:textColor="@color/vuka_text_secondary" android:textSize="14sp" />
        </LinearLayout>

        <!-- Step 4 -->
        <LinearLayout android:id="@+id/step_building"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:padding="12dp" android:background="@drawable/bg_card"
            android:alpha="0.4">
            <ProgressBar android:id="@+id/pb_step4"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="20dp" android:layout_height="20dp"
                android:indeterminateTint="@color/vuka_text_hint"
                android:layout_marginEnd="12dp" />
            <TextView android:id="@+id/tv_step4"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/building_profile"
                android:textColor="@color/vuka_text_secondary" android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

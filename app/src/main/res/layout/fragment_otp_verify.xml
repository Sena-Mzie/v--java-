<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vuka_navy_dark"
    android:padding="24dp">

    <!-- Back button -->
    <ImageButton
        android:id="@+id/btn_back_otp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_media_previous"
        android:background="@drawable/bg_card"
        android:contentDescription="@string/content_desc_back"
        android:padding="8dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Progress dots / step indicator -->
    <LinearLayout
        android:id="@+id/ll_steps"
        android:layout_width="wrap_content"
        android:layout_height="8dp"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View android:layout_width="8dp" android:layout_height="8dp"
            android:background="@drawable/bg_avatar_circle" android:layout_marginEnd="4dp" />
        <View android:layout_width="24dp" android:layout_height="8dp"
            android:background="@drawable/bg_button_primary" android:layout_marginEnd="4dp" />
        <View android:layout_width="8dp" android:layout_height="8dp"
            android:background="@drawable/bg_card" android:layout_marginEnd="4dp" />
        <View android:layout_width="8dp" android:layout_height="8dp"
            android:background="@drawable/bg_card" />
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_otp_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_vuka_shield"
        android:contentDescription="Verify number"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/ll_steps"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_otp_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/verify_number_title"
        android:textColor="@color/vuka_text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/iv_otp_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_otp_sent_to"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter the 6-digit code sent to\n+27 71 123 4567"
        android:textColor="@color/vuka_text_secondary"
        android:textSize="14sp"
        android:textAlignment="center"
        android:gravity="center"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_otp_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- OTP Input Boxes (6 digits) -->
    <LinearLayout
        android:id="@+id/ll_otp_inputs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tv_otp_sent_to"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText android:id="@+id/et_otp_1"
            android:layout_width="44dp" android:layout_height="52dp"
            android:gravity="center" android:textColor="@color/vuka_text_primary"
            android:textStyle="bold" android:textSize="22sp"
            android:inputType="number" android:maxLength="1"
            android:background="@drawable/bg_otp_box"
            android:layout_marginEnd="6dp"
            android:importantForAutofill="no"
            android:contentDescription="OTP digit 1" />

        <EditText android:id="@+id/et_otp_2"
            android:layout_width="44dp" android:layout_height="52dp"
            android:gravity="center" android:textColor="@color/vuka_text_primary"
            android:textStyle="bold" android:textSize="22sp"
            android:inputType="number" android:maxLength="1"
            android:background="@drawable/bg_otp_box"
            android:layout_marginEnd="6dp"
            android:importantForAutofill="no"
            android:contentDescription="OTP digit 2" />

        <EditText android:id="@+id/et_otp_3"
            android:layout_width="44dp" android:layout_height="52dp"
            android:gravity="center" android:textColor="@color/vuka_text_primary"
            android:textStyle="bold" android:textSize="22sp"
            android:inputType="number" android:maxLength="1"
            android:background="@drawable/bg_otp_box"
            android:layout_marginEnd="6dp"
            android:importantForAutofill="no"
            android:contentDescription="OTP digit 3" />

        <EditText android:id="@+id/et_otp_4"
            android:layout_width="44dp" android:layout_height="52dp"
            android:gravity="center" android:textColor="@color/vuka_text_primary"
            android:textStyle="bold" android:textSize="22sp"
            android:inputType="number" android:maxLength="1"
            android:background="@drawable/bg_otp_box"
            android:layout_marginEnd="6dp"
            android:importantForAutofill="no"
            android:contentDescription="OTP digit 4" />

        <EditText android:id="@+id/et_otp_5"
            android:layout_width="44dp" android:layout_height="52dp"
            android:gravity="center" android:textColor="@color/vuka_text_primary"
            android:textStyle="bold" android:textSize="22sp"
            android:inputType="number" android:maxLength="1"
            android:background="@drawable/bg_otp_box"
            android:layout_marginEnd="6dp"
            android:importantForAutofill="no"
            android:contentDescription="OTP digit 5" />

        <EditText android:id="@+id/et_otp_6"
            android:layout_width="44dp" android:layout_height="52dp"
            android:gravity="center" android:textColor="@color/vuka_text_primary"
            android:textStyle="bold" android:textSize="22sp"
            android:inputType="number" android:maxLength="1"
            android:background="@drawable/bg_otp_box"
            android:importantForAutofill="no"
            android:contentDescription="OTP digit 6" />

    </LinearLayout>

    <!-- Error message -->
    <TextView
        android:id="@+id/tv_otp_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/risk_high"
        android:textSize="13sp"
        android:textAlignment="center"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ll_otp_inputs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Countdown and Resend -->
    <LinearLayout
        android:id="@+id/ll_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_otp_error"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:45"
            android:textColor="@color/vuka_gold"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" · "
            android:textColor="@color/vuka_text_hint"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_resend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/resend"
            android:textColor="@color/vuka_text_secondary"
            android:textSize="14sp"
            android:background="@android:color/transparent"
            android:enabled="false"
            android:contentDescription="Resend OTP code" />
    </LinearLayout>

    <!-- Demo hint -->
    <TextView
        android:id="@+id/tv_demo_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/demo_otp_hint"
        android:textColor="@color/vuka_gold"
        android:textSize="13sp"
        android:textAlignment="center"
        android:gravity="center"
        android:background="@drawable/bg_demo_banner"
        android:padding="8dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/ll_countdown"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Verify Button -->
    <Button
        android:id="@+id/btn_verify_otp"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/verify"
        android:textColor="@color/vuka_navy_dark"
        android:textStyle="bold"
        android:textSize="16sp"
        android:background="@drawable/bg_button_primary"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

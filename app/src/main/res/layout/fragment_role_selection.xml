<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vuka_navy_dark"
    android:padding="20dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tv_role_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_role_title"
        android:textColor="@color/vuka_text_primary"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:gravity="center"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_role_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_role_subtitle"
        android:textColor="@color/vuka_text_secondary"
        android:textSize="14sp"
        android:textAlignment="center"
        android:gravity="center"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tv_role_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Driver Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_driver_role"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="40dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Select Driver role"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/tv_role_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_driver_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="🚗"
                android:textSize="30sp"
                android:gravity="center"
                android:background="@drawable/bg_avatar_circle"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tv_driver_role_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/role_driver"
                android:textColor="@color/vuka_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/tv_driver_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tv_driver_role_desc" />

            <TextView
                android:id="@+id/tv_driver_role_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/role_driver_desc"
                android:textColor="@color/vuka_text_secondary"
                android:textSize="13sp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/tv_driver_role_title"
                app:layout_constraintStart_toEndOf="@id/tv_driver_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Passenger Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_passenger_role"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Select Passenger role"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/card_driver_role"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_passenger_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="🧑"
                android:textSize="30sp"
                android:gravity="center"
                android:background="@drawable/bg_avatar_circle"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tv_passenger_role_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/role_passenger"
                android:textColor="@color/vuka_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/tv_passenger_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tv_passenger_role_desc" />

            <TextView
                android:id="@+id/tv_passenger_role_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/role_passenger_desc"
                android:textColor="@color/vuka_text_secondary"
                android:textSize="13sp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/tv_passenger_role_title"
                app:layout_constraintStart_toEndOf="@id/tv_passenger_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Continue Button -->
    <Button
        android:id="@+id/btn_continue_role"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/continue_btn"
        android:textColor="@color/vuka_navy_dark"
        android:textStyle="bold"
        android:textSize="16sp"
        android:background="@drawable/bg_button_primary"
        android:enabled="false"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

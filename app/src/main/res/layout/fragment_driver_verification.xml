<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vuka_navy_dark"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout android:id="@+id/ll_header"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton android:id="@+id/btn_back_verify"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="@drawable/bg_card"
            android:contentDescription="@string/content_desc_back" android:padding="8dp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/driver_verification"
            android:textColor="@color/vuka_text_primary" android:textSize="20sp"
            android:textStyle="bold" android:gravity="center" android:layout_marginStart="8dp" />
        <View android:layout_width="40dp" android:layout_height="40dp" />
    </LinearLayout>

    <!-- States Container -->
    <FrameLayout
        android:id="@+id/fl_verification_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/ll_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- QR Scan State -->
        <LinearLayout android:id="@+id/ll_scan_state"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center"
            android:visibility="visible">

            <!-- QR Camera frame simulation -->
            <FrameLayout android:layout_width="240dp" android:layout_height="240dp"
                android:background="@drawable/bg_card">
                <View android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/bg_map_simulation" />
                <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:text="[QR SCANNER]\nCAMERA ACTIVE"
                    android:textColor="@color/vuka_gold" android:textSize="16sp"
                    android:gravity="center" android:textAlignment="center" />
                <!-- Corner markers -->
                <View android:layout_width="30dp" android:layout_height="3dp"
                    android:background="@color/vuka_gold"
                    android:layout_gravity="top|start" android:layout_margin="8dp" />
                <View android:layout_width="3dp" android:layout_height="30dp"
                    android:background="@color/vuka_gold"
                    android:layout_gravity="top|start" android:layout_margin="8dp" />
                <View android:layout_width="30dp" android:layout_height="3dp"
                    android:background="@color/vuka_gold"
                    android:layout_gravity="top|end" android:layout_margin="8dp" />
                <View android:layout_width="3dp" android:layout_height="30dp"
                    android:background="@color/vuka_gold"
                    android:layout_gravity="top|end" android:layout_margin="8dp" />
            </FrameLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/scan_qr_code"
                android:textColor="@color/vuka_text_primary" android:textSize="16sp"
                android:textStyle="bold" android:textAlignment="center"
                android:gravity="center" android:layout_marginTop="20dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/or_search_manually"
                android:textColor="@color/vuka_text_hint" android:textSize="13sp"
                android:textAlignment="center" android:gravity="center"
                android:layout_marginTop="8dp" android:layout_marginBottom="20dp" />

            <Button android:id="@+id/btn_manual_search"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:text="@string/manual_search"
                android:textColor="@color/vuka_navy_dark" android:textStyle="bold"
                android:textSize="16sp" android:background="@drawable/bg_button_primary"
                android:contentDescription="Enter driver details manually" />

            <Button android:id="@+id/btn_demo_scan"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:text="Demo: Simulate Scan"
                android:textColor="@color/vuka_text_secondary" android:textSize="14sp"
                android:background="@drawable/bg_button_secondary"
                android:layout_marginTop="8dp"
                android:contentDescription="Simulate a QR code scan for demonstration" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/simulated_verification_note"
                android:textColor="@color/vuka_text_hint" android:textSize="10sp"
                android:textAlignment="center" android:gravity="center" android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Verified State -->
        <androidx.core.widget.NestedScrollView android:id="@+id/ll_verified_state"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="4dp">

                <!-- Verified Banner -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"
                    android:orientation="horizontal" android:gravity="center"
                    android:background="@drawable/bg_status_verified"
                    android:layout_marginBottom="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="✅ " android:textSize="20sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/driver_verified"
                        android:textColor="@color/status_verified" android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Driver Info Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="@color/card_bg" app:cardCornerRadius="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">
                            <TextView android:layout_width="56dp" android:layout_height="56dp"
                                android:text="TM" android:textColor="@color/vuka_gold"
                                android:textStyle="bold" android:textSize="18sp"
                                android:gravity="center" android:background="@drawable/bg_avatar_circle"
                                android:layout_marginEnd="12dp" />
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView android:id="@+id/tv_verified_driver_name"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Thabo Mokoena"
                                    android:textColor="@color/vuka_text_primary" android:textSize="16sp"
                                    android:textStyle="bold" />
                                <TextView android:id="@+id/tv_verified_driver_id"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="ID: CA 123-456 (DEMO)"
                                    android:textColor="@color/vuka_text_secondary" android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Checklist -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical"
                                android:layout_marginBottom="8dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="✅" android:textSize="16sp" android:layout_marginEnd="8dp" />
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:text="Driver Name: Thabo Mokoena"
                                    android:textColor="@color/vuka_text_primary" android:textSize="13sp" />
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical"
                                android:layout_marginBottom="8dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="✅" android:textSize="16sp" android:layout_marginEnd="8dp" />
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:text="Registration: CA 123-455"
                                    android:textColor="@color/vuka_text_primary" android:textSize="13sp" />
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical"
                                android:layout_marginBottom="8dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="✅" android:textSize="16sp" android:layout_marginEnd="8dp" />
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:text="Vehicle: Toyota Corolla · White"
                                    android:textColor="@color/vuka_text_primary" android:textSize="13sp" />
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="✅" android:textSize="16sp" android:layout_marginEnd="8dp" />
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:text="Platform: Uber"
                                    android:textColor="@color/vuka_text_primary" android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <Button android:id="@+id/btn_start_trip_verified"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:text="Start Trip"
                    android:textColor="@color/vuka_navy_dark" android:textStyle="bold"
                    android:textSize="16sp" android:background="@drawable/bg_button_primary"
                    android:layout_marginTop="8dp"
                    android:contentDescription="Start the trip after driver verification" />

                <Button android:id="@+id/btn_scan_again"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:text="Scan Again"
                    android:textColor="@color/vuka_text_secondary" android:textSize="14sp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Scan the driver QR code again" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Mismatch State -->
        <LinearLayout android:id="@+id/ll_mismatch_state"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:padding="16dp"
            android:visibility="gone">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="⚠" android:textSize="64sp" android:gravity="center" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/vehicle_mismatch_warning"
                android:textColor="@color/sos_red" android:textSize="20sp"
                android:textStyle="bold" android:textAlignment="center" android:gravity="center"
                android:layout_marginTop="16dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="The vehicle details do not match the registered driver profile. Do not board this vehicle."
                android:textColor="@color/vuka_text_secondary" android:textSize="14sp"
                android:textAlignment="center" android:gravity="center"
                android:layout_marginTop="8dp" android:layout_marginBottom="24dp" />

            <Button android:id="@+id/btn_notify_contacts_mismatch"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:text="@string/notify_contacts"
                android:textColor="@color/white" android:textStyle="bold"
                android:textSize="16sp" android:background="@drawable/bg_sos_button"
                android:contentDescription="Notify trusted contacts of vehicle mismatch" />

            <Button android:id="@+id/btn_dismiss_mismatch"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:text="@string/dismiss" android:textColor="@color/vuka_text_secondary"
                android:textSize="14sp" android:background="@android:color/transparent"
                android:layout_marginTop="8dp"
                android:contentDescription="Dismiss mismatch warning" />
        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
